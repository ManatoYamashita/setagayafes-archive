# Dependencies and build output
node_modules/
dist/
# Deployment zips (pnpm package). Built from a commit; never committed.
release/
.astro/

# Local environment
.env
.env.*
.DS_Store
Thumbs.db
desktop.ini

# Reference material that must never be committed.
# The reference design is a third-party template; keep it here locally only.
/reference/

# Files that must never be published (see docs/rules/conventions.md).
# The guard scripts check public/ and dist/ as well.
*.sql
*.sql.*
*.dump
*.bak
*.backup
*.log
*.xls
*.xlsx

# Logs from package managers
npm-debug.log*
pnpm-debug.log*
