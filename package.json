{
  "name": "setagayafes-archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/guard-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard": "node scripts/guard-source.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "node --test \"e2e/**/*.e2e.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm guard && pnpm build && pnpm test:e2e",
    "capture": "node scripts/capture.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.3"
    }
  }
}
