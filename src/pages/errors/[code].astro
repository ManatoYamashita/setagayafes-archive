---
// /errors/NNN.html: one page per status code, all from this template. The
// generated .htaccess points ErrorDocument here, so the server answers a failed
// URL with this page and the original status (404 stays 404).
// Japanese comes first and English second on the same page: the server cannot
// pick a language for an error (docs/design/screen.md, "エラーページ").
import ErrorHeader from "../../components/ErrorHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import {
  ERROR_CODES,
  ERROR_UI,
  LATEST_FESTIVAL_URL,
  REASON_PHRASES,
  errorMessageOf,
  errorPageTitle,
  type ErrorCode,
} from "../../i18n/errors.ts";
import { HOME_PATHS } from "../../i18n/ui.ts";
import ErrorLayout from "../../layouts/ErrorLayout.astro";

export function getStaticPaths() {
  return ERROR_CODES.map((code) => ({ params: { code: String(code) }, props: { code } }));
}

interface Props {
  code: ErrorCode;
}

const { code } = Astro.props;
const message = errorMessageOf(code);
---

<ErrorLayout title={errorPageTitle(code)}>
  <div class="shell">
    <ErrorHeader />

    <main class="page error">
      <p class="status">
        <span class="code">{code}</span>
        <span class="reason" lang="en">
          {REASON_PHRASES[code]}
        </span>
      </p>

      <h1 class="title">
        <span class="ja">{message.ja.title}</span>
        <span class="en" lang="en">
          {message.en.title}
        </span>
      </h1>

      <div class="lead">
        <p>{message.ja.lead}</p>
        <p class="en" lang="en">
          {message.en.lead}
        </p>
      </div>

      <div class="actions">
        <a class="primary" href={HOME_PATHS.ja}>
          <span class="label">
            <span class="ja">{ERROR_UI.ja.home}</span>
            <span class="en" lang="en">
              {ERROR_UI.en.home}
            </span>
          </span>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </a>
        <a class="secondary" href={LATEST_FESTIVAL_URL}>
          <span class="label">
            <span class="ja">{ERROR_UI.ja.latest}</span>
            <span class="en" lang="en">
              {ERROR_UI.en.latest}
            </span>
          </span>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M6 3.5h6.5V10M12.5 3.5 4 12" />
          </svg>
        </a>
      </div>
    </main>

    <SiteFooter lang="ja" minimal />
  </div>
</ErrorLayout>

<style>
  /* The footer stays at the bottom of short screens. */
  .shell {
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    min-block-size: 100dvh;
  }

  .error {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    inline-size: 100%;
    padding-block: 3rem 4rem;

    @media (width >= 48rem) {
      padding-block: 4rem 6rem;
    }
  }

  .status {
    display: grid;
    gap: 0.75rem;
  }

  /* The number is the page's one large figure, set like the top page's Latin headings. */
  .code {
    font-family: var(--font-display);
    font-size: clamp(7rem, 4rem + 16vw, 15rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.03em;
  }

  .reason {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .title {
    display: grid;
    gap: 0.5rem;
    max-inline-size: 40rem;
    margin-block-start: 1rem;

    & .ja {
      font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
      font-weight: 800;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    & .en {
      font-family: var(--font-display);
      font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
      font-weight: 700;
      line-height: 1.3;
      color: var(--color-muted);
    }
  }

  .lead {
    display: grid;
    gap: 0.375rem;
    max-inline-size: 36rem;
    font-size: 0.9375rem;
    line-height: 1.8;

    & p {
      word-break: auto-phrase;
    }

    & .en {
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--color-muted);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-start: 1rem;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-block-size: 3.5rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    padding-inline: 1.5rem 1.25rem;
    text-decoration: none;

    & svg {
      flex: none;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  .primary {
    background-color: var(--color-ink);
    color: var(--color-paper);

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-paper);
        color: var(--color-ink);
      }
    }
  }

  .secondary {
    @media (hover: hover) {
      &:hover {
        background-color: var(--color-ink);
        color: var(--color-paper);
      }
    }
  }

  .label {
    display: grid;
    padding-block: 0.5rem;

    & .ja {
      font-size: 0.875rem;
      font-weight: 700;
      line-height: 1.4;
      word-break: auto-phrase;
    }

    & .en {
      font-size: 0.75rem;
      line-height: 1.4;
      opacity: 0.75;
    }
  }

  /* Phones: the buttons fill the width, one above the other. */
  @media (width < 30rem) {
    .actions {
      justify-self: stretch;
      flex-direction: column;
      align-items: stretch;
    }

    .primary,
    .secondary {
      justify-content: space-between;
    }
  }
</style>
