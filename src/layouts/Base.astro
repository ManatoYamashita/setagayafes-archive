---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "ja" | "en";
}

const { title, description, lang = "ja" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-dvh bg-paper text-ink antialiased">
    <slot />
  </body>
</html>
