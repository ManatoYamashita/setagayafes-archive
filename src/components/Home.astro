---
// The archive top page. "/" and "/en/" render the same page in each language.
import { FESTIVALS, festivalNameOf, yearOf, type Lang } from "../data/festivals.ts";
import { UI, roundLabel } from "../i18n/ui.ts";
import Base from "../layouts/Base.astro";
import { OG_IMAGE_SIZE, hasCapture, ogImageOf } from "../lib/captures.ts";
import Archive from "./Archive.astro";
import Hero from "./Hero.astro";
import RelatedSites from "./RelatedSites.astro";
import SitePreview from "./SitePreview.astro";
import { hasPreview } from "../lib/preview.ts";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];
const rounds = FESTIVALS.map((festival) => festival.round);
const firstRound = Math.min(...rounds);

// The link preview shows the newest festival that has been captured. A new
// festival added before `pnpm capture` keeps the previous one's picture.
const capturedRounds = rounds.filter(hasCapture);
const imageRound = capturedRounds.length > 0 ? Math.max(...capturedRounds) : undefined;
const image =
  imageRound === undefined
    ? undefined
    : {
        url: new URL((await ogImageOf(imageRound)).src, Astro.site).href,
        ...OG_IMAGE_SIZE,
        alt: ui.ogImageAlt(roundLabel(imageRound, lang), festivalNameOf(imageRound)[lang]),
      };
---

<Base
  lang={lang}
  title={ui.siteName}
  description={ui.description({ round: firstRound, year: yearOf(firstRound) })}
  image={image}
>
  <SiteHeader lang={lang} />
  <main>
    <Hero lang={lang} />
    <Archive lang={lang} />
    <RelatedSites lang={lang} />
    {/* The preview dialogs, one per festival; the hero and the cards open them. */}
    {FESTIVALS.filter(hasPreview).map((festival) => (
      <SitePreview festival={festival} lang={lang} />
    ))}
  </main>
  <SiteFooter lang={lang} />
</Base>
