---
// One row after the reference layout: the MENU icon, links to the page's
// sections and the outlined "Official site" button on the left, the organiser
// on the right. On phones only the icon and the button stay; the sections
// follow one another on the page.
//
// The menu is a native popover opened by `popovertarget`: no JavaScript, and
// the browser handles Escape, outside clicks and focus return. The same links
// are in the footer, so they stay reachable where popover is unsupported.
// The last item switches to the other language's top page.
import type { Lang } from "../data/festivals.ts";
import { ORGANIZER, SITE_LINKS } from "../data/site-links.ts";
import { HOME_PATHS, LANG_NAMES, UI, otherLang } from "../i18n/ui.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];
const other = otherLang(lang);
const MENU_ID = "site-menu";
const [official] = SITE_LINKS;
const sections = [
  { href: "#latest", label: ui.navLatest },
  { href: "#archive", label: ui.navArchive },
  { href: "#related", label: ui.navRelated },
];
---

<header class="page">
  <div class="bar">
    <button type="button" class="menu-button" popovertarget={MENU_ID} aria-label={ui.menu}>
      {/* Three lines of falling length, after the reference's menu glyph (without its magnifier: there is no search). */}
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path d="M3 6.5h18M3 12h14M3 17.5h10" />
      </svg>
    </button>

    <nav class="sections" aria-label={ui.sectionsLabel}>
      <ul role="list">
        {sections.map((section) => (
          <li>
            <a href={section.href}>{section.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Leaves the page, so it is not one of the section links. */}
    <a class="language" href={HOME_PATHS[other]} hreflang={other} lang={other}>
      {LANG_NAMES[other]}
    </a>

    <a class="outline-button official" href={official.url}>
      {official.label[lang]}
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <path d="M6 3.5h6.5V10M12.5 3.5 4 12" />
      </svg>
    </a>

    <p class="org">
      <span class="run-by">{ui.runBy}</span>
      {ORGANIZER[lang]}
    </p>
  </div>

  <nav id={MENU_ID} class="menu" popover aria-label={ui.menuLabel}>
    <ul>
      {SITE_LINKS.map((link) => (
        <li>
          <a href={link.url}>{link.label[lang]}</a>
        </li>
      ))}
      <li>
        <a href={HOME_PATHS[other]} hreflang={other} lang={other}>
          {LANG_NAMES[other]}
        </a>
      </li>
    </ul>
    <button type="button" class="close" popovertarget={MENU_ID} popovertargetaction="hide">
      {ui.close}
    </button>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: 0.25rem 1.25rem;
    min-block-size: 4.5rem;
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .menu-button {
    display: inline-grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-start: -0.625rem;
    border-radius: 999px;
    cursor: pointer;

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-wash);
      }
    }
  }

  /* The section links and the language switch: wide screens only. */
  .sections,
  .language {
    display: none;
  }

  @media (width >= 64rem) {
    .sections {
      display: block;
    }

    .sections ul {
      display: flex;
      gap: 1.25rem;
    }

    .sections a,
    .language {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
    }
  }

  @media (hover: hover) {
    .sections a:hover,
    .language:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.3em;
    }
  }

  .official {
    min-block-size: 2.25rem;
    padding-inline: 0.875rem;
  }

  .org {
    display: none;
    margin-inline-start: auto;
    font-size: 0.75rem;

    @media (width >= 64rem) {
      display: block;
    }
  }

  .run-by {
    margin-inline-end: 0.5rem;
    color: var(--color-muted);
  }

  .menu {
    /* Reset the centered UA popover and pin it under the MENU button. */
    --menu-top: 4.25rem;
    position: fixed;
    /* Line up with the page's left edge, also on screens wider than the page. */
    /* % of the viewport without the scrollbar (the containing block of position: fixed). */
    inset: var(--menu-top) auto auto max(1rem, calc((100% - 76rem) / 2 + 1.5rem));
    margin: 0;
    inline-size: min(18rem, calc(100% - 2rem));
    max-block-size: calc(100dvh - var(--menu-top) - 0.5rem);
    overflow-y: auto;
    overscroll-behavior-y: contain;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    padding: 0.5rem 1.25rem 1.25rem;
    background-color: var(--color-paper);
    color: var(--color-ink);

    & ul {
      display: grid;
    }

    & li + li {
      border-block-start: 1px solid var(--color-wash);
    }

    & a {
      display: block;
      padding-block: 0.875rem;
      font-size: 1.125rem;
      text-decoration: none;
    }

    @media (hover: hover) {
      & a:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }

  .close {
    margin-block-start: 0.75rem;
    min-block-size: 2.75rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    padding-inline: 1rem;
    font-size: 0.8125rem;
    cursor: pointer;

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-ink);
        color: var(--color-paper);
      }
    }
  }
</style>
