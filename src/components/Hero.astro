---
// The top of the page, after a centered product-hero layout: the site's name
// in large type over two lines (the second muted), a lead, two buttons, and a
// large rounded frame with the latest festival's screenshot.
//
// The rounds, years and count come from the data, so next year's entry
// updates the lead and the picture without touching this file.
import { FESTIVALS, latestFestival, linkOf, yearOf, type Lang } from "../data/festivals.ts";
import { UI, roundLabel } from "../i18n/ui.ts";
import Capture from "./Capture.astro";
import PreviewActions from "./PreviewActions.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];
const latest = latestFestival();
const firstRound = Math.min(...FESTIVALS.map((festival) => festival.round));
const span = {
  first: { round: firstRound, year: yearOf(firstRound) },
  last: { round: latest.round, year: yearOf(latest.round) },
  count: FESTIVALS.length,
};
const label = roundLabel(latest.round, lang);
const href = linkOf(latest);
const [titleLead, titleRest] = ui.heroTitle;
// The festival sites are in Japanese; say so on links from the English page.
const hreflang = lang === "ja" ? undefined : "ja";
---

<section id="latest" class="page hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="title">
    <span class="line">
      {titleLead.map((phrase, index) => (
        <>
          {index > 0 && <wbr />}
          {phrase}
        </>
      ))}
    </span>
    <span class="line rest">{titleRest}</span>
  </h1>

  <p class="lead">{ui.heroLead(span)}</p>

  <div class="actions">
    <a class="primary" href={href} hreflang={hreflang}>
      {ui.visit(label)}
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <path d="M2 8h11M9 4l4 4-4 4"></path>
      </svg>
    </a>
    <a class="outline-button secondary" href="#archive">
      {ui.seeArchive}
    </a>
  </div>

  {/* Over the picture, the same buttons as on the cards (PreviewActions.astro). */}
  <div class="frame">
    <Capture
      round={latest.round}
      tone="dark"
      priority="high"
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="(width >= 68rem) 64rem, calc(100vw - 2rem)"
    />
    <PreviewActions festival={latest} lang={lang} />
  </div>
</section>

<style>
  .hero {
    display: grid;
    justify-items: center;
    padding-block: 3.5rem 5rem;
    text-align: center;

    @media (width >= 48rem) {
      padding-block: 5rem 6rem;
    }
  }

  .title {
    font-size: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    /*
     * Break Japanese only at the <wbr> between phrases ("東京都市大学／世田谷祭"):
     * auto-phrase treats the whole name as one phrase and split it mid-word.
     */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .line {
    display: block;
  }

  /* The second line is muted, as in the reference (7:1 on white). */
  .rest {
    color: var(--color-muted);
  }

  .lead {
    max-inline-size: 40rem;
    margin-block-start: 1.75rem;
    font-size: 1rem;
    line-height: 1.9;
    /* A long paragraph reads better ragged-right on phones. */
    text-align: start;

    @media (width >= 40rem) {
      text-align: center;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 2.25rem;
  }

  .primary,
  .secondary {
    min-block-size: 3rem;
    padding-inline: 1.5rem;
    font-size: 0.875rem;
  }

  .primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-weight: 700;
    text-decoration: none;

    & svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.75;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-paper);
        color: var(--color-ink);
      }
    }
  }

  .frame {
    display: grid;
    inline-size: 100%;
    max-inline-size: 64rem;
    margin-block-start: 3.5rem;
    overflow: hidden;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 1.25rem;
  }

  /* The picture and the buttons share one cell. :global: other components. */
  .frame > :global(.capture),
  .frame > :global(.preview-actions) {
    grid-area: 1 / 1;
  }

  /* A dark veil with the buttons, shown on hover or when a button has focus. */
  .frame > :global(.preview-actions) {
    /* Above the picture, whose box is positioned (Capture.astro). */
    position: relative;
    z-index: 1;
    background-color: rgb(0 0 0 / 0.55);
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }

  .frame > :global(.preview-actions > *) {
    pointer-events: none;
  }

  .frame:focus-within > :global(.preview-actions) {
    opacity: 1;
  }

  .frame:focus-within > :global(.preview-actions > *) {
    pointer-events: auto;
  }

  @media (hover: hover) {
    .frame:hover > :global(.preview-actions) {
      opacity: 1;
    }

    .frame:hover > :global(.preview-actions > *) {
      pointer-events: auto;
    }
  }

  /* Touch screens: no veil; the buttons sit in a row under the picture. */
  @media (hover: none) {
    .frame {
      overflow: visible;
      border: 0;
      border-radius: 0;
    }

    .frame > :global(.capture) {
      overflow: hidden;
      border: 1px solid rgb(0 0 0 / 0.12);
      border-radius: 1.25rem;
    }

    .frame > :global(.preview-actions),
    .frame:focus-within > :global(.preview-actions) {
      grid-area: 2 / 1;
      padding-block-start: 1rem;
      background: none;
      opacity: 1;
    }

    .frame > :global(.preview-actions > *) {
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame > :global(.preview-actions) {
      transition: none;
    }
  }
</style>
