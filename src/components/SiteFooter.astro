---
// The footer after the reference layout: the site name in the middle, then a
// row with the social media icons, the copyright and the other links.
// Together they repeat the MENU links, so they stay reachable in browsers
// without the Popover API. A small credit for the builder, with a way to report
// bugs and requests, closes the footer.
import { Image } from "astro:assets";
import creditLogo from "../assets/credit/yamashitamana-to.png";
import type { Lang } from "../data/festivals.ts";
import { ORGANIZER, SITE_CREDIT, SITE_LINKS } from "../data/site-links.ts";
import { HOME_PATHS, LANG_NAMES, UI, otherLang } from "../i18n/ui.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];
const other = otherLang(lang);
const social = SITE_LINKS.filter((link) => "icon" in link);
const [official, ...others] = SITE_LINKS.filter((link) => !("icon" in link));
---

<footer class="footer">
  <div class="page inner">
    <p class="logo">{ui.siteName}</p>
    <p class="note">{ui.footerNote}</p>

    <div class="bottom">
      <nav class="social" aria-label={ui.socialLabel}>
        <ul role="list">
          {social.map((link) => (
            <li>
              <a href={link.url} aria-label={link.label[lang]}>
                {link.icon === "x" ? (
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.3 4.7H5.5l11.2 14.5Z" />
                  </svg>
                ) : (
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2Zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm4.8-8.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM12 2.5c-2.6 0-2.9 0-3.9.1-3.5.2-5.4 2.1-5.6 5.6-.1 1-.1 1.3-.1 3.8s0 2.9.1 3.9c.2 3.5 2.1 5.4 5.6 5.6 1 .1 1.3.1 3.9.1s2.9 0 3.9-.1c3.5-.2 5.4-2.1 5.6-5.6.1-1 .1-1.3.1-3.9s0-2.8-.1-3.8c-.2-3.5-2.1-5.4-5.6-5.6-1-.1-1.3-.1-3.9-.1Zm0 1.7c2.5 0 2.8 0 3.8.1 2.5.1 3.7 1.3 3.8 3.8.1 1 .1 1.3.1 3.8s0 2.8-.1 3.8c-.1 2.5-1.3 3.7-3.8 3.8-1 .1-1.3.1-3.8.1s-2.8 0-3.8-.1c-2.5-.1-3.7-1.3-3.8-3.8-.1-1-.1-1.3-.1-3.8s0-2.8.1-3.8c.1-2.5 1.3-3.7 3.8-3.8 1-.1 1.3-.1 3.8-.1Z" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <p class="copyright">© {ORGANIZER[lang]}</p>

      <nav class="links" aria-label={ui.footerMenuLabel}>
        <ul role="list">
          {others.map((link) => (
            <li>
              <a class="text-link" href={link.url}>
                {link.label[lang]}
              </a>
            </li>
          ))}
          <li>
            <a class="text-link" href={HOME_PATHS[other]} hreflang={other} lang={other}>
              {LANG_NAMES[other]}
            </a>
          </li>
          {official && (
            <li>
              <a class="outline-button" href={official.url}>
                {official.label[lang]}
              </a>
            </li>
          )}
        </ul>
      </nav>
    </div>

    <div class="credit">
      <p>
        {ui.credit.before}
        <span class="nowrap">
          <a class="credit-logo" href={SITE_CREDIT.url} rel="author">
            <Image
              src={creditLogo}
              alt={SITE_CREDIT.name}
              format="avif"
              height={16}
              densities={[1, 2]}
              loading="lazy"
            />
          </a>
          {ui.credit.after}
        </span>
      </p>
      <p>
        {ui.credit.contactBefore}
        <a class="credit-contact" href={SITE_CREDIT.contactUrl}>
          {ui.credit.contactLabel}
        </a>
        {ui.credit.contactAfter}
      </p>
    </div>
  </div>
</footer>

<style>
  .inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-block: 5rem 2.5rem;
    text-align: center;
  }

  .logo {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .note {
    word-break: auto-phrase;
    max-inline-size: 36rem;
    font-size: 0.75rem;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1rem;
    inline-size: 100%;
    margin-block-start: 3rem;

    @media (width >= 48rem) {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 1.5rem;

      & .social {
        justify-self: start;
      }

      & .links {
        justify-self: end;
      }
    }
  }

  .social ul,
  .links ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1rem;
  }

  .social a {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 999px;

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-wash);
      }
    }
  }

  .social svg {
    fill: currentColor;
  }

  .copyright {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .credit {
    word-break: auto-phrase;
    max-inline-size: 36rem;
    margin-block-start: 1rem;
    font-size: 0.75rem;
    line-height: 1.8;
    color: var(--color-muted);

    & .credit-contact {
      white-space: nowrap;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.25em;
    }
  }

  /* The logo sits in the sentence like a word, with a 44px tall target. */
  .credit-logo {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    margin-inline: 0.375em;
    vertical-align: middle;

    & img {
      block-size: 1rem;
      inline-size: auto;
    }
  }

  /* English has a space before the logo in the text, and a full stop right after it. */
  :global(:lang(en)) .credit-logo {
    margin-inline: 0 0.0625em;
  }

  .nowrap {
    white-space: nowrap;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
</style>
