---
// Sites that are not Setagaya Festival rounds but live on the same host, as
// picture tiles on a wash band after the reference layout. Large rings cross
// the band's edges; they are decoration only.
//
// A site with `blockedBy` is listed without a link until that Issue is closed
// (used for the Todoroki Festival sites until they were made static: Issue #2).
// Its picture comes from `pnpm capture related`; before that, a plain plate.
import { Image } from "astro:assets";
import type { Lang } from "../data/festivals.ts";
import { RELATED_SITES } from "../data/related-sites.ts";
import { UI } from "../i18n/ui.ts";
import { CAPTURE_IMAGE_PROPS, relatedCaptureOf } from "../lib/captures.ts";
import { formatDateRange } from "../lib/format.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];

function whenOf(site: (typeof RELATED_SITES)[number]): { label: string; datetime: string } {
  if ("dates" in site) {
    return { label: formatDateRange(site.dates.start, site.dates.end), datetime: site.dates.start };
  }
  return { label: String(site.year), datetime: String(site.year) };
}

/** Tiles are a third of the page from 48rem (max 76rem), the full page below. */
const SIZES = "auto, (width >= 48rem) min(24rem, calc((100vw - 5rem) / 3)), calc(100vw - 2rem)";
---

<section id="related" class="band" aria-labelledby="related-title">
  <div class="rings" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="page inner">
    <h2 id="related-title" class="display-heading">
      {ui.relatedVertical && <span class="vertical">{ui.relatedVertical}</span>}
      <span class="word" lang={lang === "en" ? undefined : "en"}>
        {ui.relatedWord}
      </span>
    </h2>

    <ul class="tiles" role="list">
      {RELATED_SITES.map((site) => {
        const when = whenOf(site);
        const linked = !("blockedBy" in site);
        const image = relatedCaptureOf(site.id);
        const content = (
          <>
            {image ? (
              <Image
                src={image}
                alt=""
                {...CAPTURE_IMAGE_PROPS}
                width={1280}
                height={800}
                widths={[400, 640, 960, 1280]}
                sizes={SIZES}
                loading="lazy"
                class="photo"
              />
            ) : (
              <span class="photo plate" />
            )}
            <span class="caption">
              <time class="when" datetime={when.datetime}>
                {when.label}
              </time>
              <span class="name">{site.name[lang]}</span>
              {!linked && <span class="tag">{ui.comingSoon}</span>}
            </span>
          </>
        );
        return (
          <li>
            {linked ? (
              <a class="tile" href={site.path} hreflang={lang === "ja" ? undefined : "ja"}>
                {content}
              </a>
            ) : (
              <div class="tile">{content}</div>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    background-color: var(--color-wash);
    /* The rings are cut by the band's edges, as in the reference. */
    overflow: clip;
  }

  .inner {
    display: grid;
    gap: 2rem;
    padding-block: 3.5rem 4.5rem;
  }

  /* Thick black rings echoing the reference's circles, behind the tiles. */
  .rings {
    position: absolute;
    z-index: -1;
    inset: 0;

    & span {
      position: absolute;
      aspect-ratio: 1;
      inline-size: clamp(10rem, 22vw, 20rem);
      border: 0.375rem solid var(--color-ink);
      border-radius: 50%;
    }

    /* Two rings hang from the top edge, three rise from the bottom edge. */
    & span:nth-child(-n + 2) {
      inset-block-start: 0;
      translate: 0 -58%;
    }

    & span:nth-child(n + 3) {
      inset-block-end: 0;
      translate: 0 55%;
    }

    & span:nth-child(1) {
      inset-inline-start: 38%;
    }

    & span:nth-child(2) {
      inset-inline-start: 72%;
    }

    & span:nth-child(3) {
      inset-inline-start: -3%;
    }

    & span:nth-child(4) {
      inset-inline-start: 40%;
    }

    & span:nth-child(5) {
      inset-inline-end: -5%;
    }
  }

  .tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tile {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: 0.375rem;
    background-color: var(--color-ink);
    color: var(--color-paper);
    text-decoration: none;

    & > * {
      grid-area: 1 / 1;
    }
  }

  /* :global: the class is on astro:assets' <img>, outside this component's scope. */
  .tile :global(.photo) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: top;
    transition: scale 0.4s ease-out;
  }

  a.tile:hover :global(.photo) {
    scale: 1.04;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile :global(.photo) {
      transition: none;
    }

    a.tile:hover :global(.photo) {
      scale: none;
    }
  }

  .plate {
    background-color: var(--color-muted);
  }

  /* White text on a dark fade at the bottom, with a short bar under the name. */
  .caption {
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: end;
    gap: 0.25rem;
    padding: 1.25rem;
    background-image: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.05) 70%);
  }

  .when {
    font-size: 0.75rem;
  }

  .name {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;

    &::after {
      content: "";
      display: block;
      inline-size: 2.5rem;
      block-size: 3px;
      margin-block-start: 0.375rem;
      background-color: currentColor;
    }
  }

  a.tile:focus-visible {
    outline-offset: 4px;
  }
</style>
