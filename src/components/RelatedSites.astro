---
// Sites that are not Setagaya Festival rounds but live on the same host.
// A site with `blockedBy` is listed without a link until that Issue is closed
// (used for the Todoroki Festival sites until they were made static: Issue #2).
import type { Lang } from "../data/festivals.ts";
import { RELATED_SITES } from "../data/related-sites.ts";
import { UI } from "../i18n/ui.ts";
import { formatDateRange } from "../lib/format.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];

function whenOf(site: (typeof RELATED_SITES)[number]): { label: string; datetime: string } {
  if ("dates" in site) {
    return { label: formatDateRange(site.dates.start, site.dates.end), datetime: site.dates.start };
  }
  return { label: String(site.year), datetime: String(site.year) };
}
---

<section class="page" aria-labelledby="related-title">
  <div class="related">
    <h2 id="related-title" class="heading">
      <span class="dot" aria-hidden="true"></span>
      {ui.relatedSites}
    </h2>
    <ul class="list" role="list">
      {RELATED_SITES.map((site) => {
        const when = whenOf(site);
        const linked = !("blockedBy" in site);
        return (
          <li class="item">
            <time class="when" datetime={when.datetime}>
              {when.label}
            </time>
            {linked ? (
              <a class="site" href={site.path} hreflang={lang === "ja" ? undefined : "ja"}>
                {site.name[lang]}
              </a>
            ) : (
              <span class="site">
                {site.name[lang]}
                <span class="tag">{ui.comingSoon}</span>
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .related {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
    border-block-start: 1px solid var(--color-line);
    padding-block: 2.5rem 3.5rem;

    @media (width >= 48rem) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .item {
    display: grid;
    gap: 0.25rem 1.5rem;
    border-block-end: 1px solid var(--color-wash);
    padding-block: 1rem;

    &:first-child {
      padding-block-start: 0;
    }

    @media (width >= 40rem) {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .when {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .site {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-size: 1.0625rem;
  }

  a.site {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }

  span.site {
    color: var(--color-muted);
  }
</style>
