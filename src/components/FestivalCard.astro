---
// One festival in the archive grid: picture, meta line, theme, festival name.
// The whole card is clickable through the heading link (stretched with
// ::after), so the link text stays the theme instead of the whole card.
import {
  ERA_NAMES,
  STATUS_LABELS,
  eraOf,
  festivalNameOf,
  linkOf,
  titleOf,
  type Festival,
} from "../data/festivals.ts";
import { formatDateRange, roundLabel } from "../lib/format.ts";
import Capture from "./Capture.astro";

interface Props {
  festival: Festival;
  /** The `sizes` attribute for the picture; the grid knows how wide the card is. */
  sizes: string;
}

const { festival, sizes } = Astro.props;
const { round, dates } = festival;
const era = eraOf(round);
const status = STATUS_LABELS[festival.status];
const external = festival.externalLink;
---

<li class="card" data-era={era}>
  <article>
    <Capture round={round} widths={[320, 480, 640, 800, 960, 1280, 1600, 2000]} sizes={sizes} />
    <p class="meta">
      <time datetime={dates.start}>
        {formatDateRange(dates.start, dates.end)}
        {dates.estimated && <span>（推定）</span>}
      </time>
      <span aria-hidden="true">/</span>
      <span>{roundLabel(round)}</span>
      <span aria-hidden="true">/</span>
      <span class="tag">{ERA_NAMES[era].ja}</span>
      {status && <span class="tag">{status.ja}</span>}
    </p>
    <h3 class="title">
      <a href={linkOf(festival)}>
        <span class="sr-only">{roundLabel(round)} </span>
        {titleOf(festival, "ja")}
      </a>
    </h3>
    <p class="name">
      {festivalNameOf(round).ja}
      {festival.statusReason && <span>{festival.statusReason.ja}</span>}
      {external && <span>{external.label.ja}</span>}
    </p>
  </article>
</li>

<style>
  .card {
    position: relative;
  }

  article {
    display: grid;
    gap: 0.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-block-start: 0.25rem;
    font-size: 0.75rem;
  }

  .title {
    /* The grid enlarges the title of its featured cards. */
    font-size: var(--card-title-size, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;

    & a {
      text-decoration: none;
    }

    /* Stretch the link over the whole card. */
    & a::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    & a:focus-visible {
      outline: none;
    }
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 0.5rem;
  }

  .card:hover .title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
