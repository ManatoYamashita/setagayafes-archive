---
// One festival in the archive grid: picture, meta line, theme, festival name.
// The whole card is clickable through the heading link (stretched with
// ::after), so the link text stays the theme instead of the whole card.
import {
  ERA_NAMES,
  STATUS_LABELS,
  eraOf,
  festivalNameOf,
  linkOf,
  type Festival,
  type Lang,
} from "../data/festivals.ts";
import { UI, headingOf, roundLabel } from "../i18n/ui.ts";
import { formatDateRange } from "../lib/format.ts";
import Capture from "./Capture.astro";

interface Props {
  festival: Festival;
  lang: Lang;
  /** The `sizes` attribute for the picture; the grid knows how wide the card is. */
  sizes: string;
}

const { festival, lang, sizes } = Astro.props;
const ui = UI[lang];
const { round, dates } = festival;
const era = eraOf(round);
const status = STATUS_LABELS[festival.status];
const external = festival.externalLink;
const heading = headingOf(festival, lang);
const label = roundLabel(round, lang);
---

<li class="card" data-era={era}>
  <article>
    <Capture round={round} widths={[320, 480, 640, 800, 960, 1280]} sizes={sizes} />
    <p class="meta">
      <time datetime={dates.start}>
        {formatDateRange(dates.start, dates.end)}
        {dates.estimated && <span>{ui.estimated}</span>}
      </time>
      <span aria-hidden="true">/</span>
      <span>{label}</span>
      <span aria-hidden="true">/</span>
      <span class="tag">{ERA_NAMES[era][lang]}</span>
      {status && <span class="tag">{status[lang]}</span>}
    </p>
    <h3 class="title">
      {/* The festival sites are in Japanese; say so on links from "/en/". */}
      <a href={linkOf(festival)} hreflang={lang === "ja" ? undefined : "ja"}>
        <span class="sr-only">{label} </span>
        <span lang={heading.lang === lang ? undefined : heading.lang}>{heading.text}</span>
        {heading.translation && <span class="translation">{heading.translation}</span>}
      </a>
    </h3>
    <p class="name">
      {festivalNameOf(round)[lang]}
      {festival.statusReason && <span>{festival.statusReason[lang]}</span>}
      {external && <span>{external.label[lang]}</span>}
    </p>
  </article>
</li>

<style>
  .card {
    position: relative;
  }

  article {
    display: grid;
    gap: 0.75rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-block-start: 0.25rem;
    font-size: 0.75rem;
  }

  .title {
    /* The grid enlarges the title of its featured cards. */
    font-size: var(--card-title-size, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;

    & a {
      text-decoration: none;
    }

    /* Stretch the link over the whole card. */
    & a::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    & a:focus-visible {
      outline: none;
    }
  }

  /* The English rendering of a Japanese theme, under the original on "/en/". */
  .translation {
    display: block;
    margin-block-start: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 0.5rem;
  }

  .card:hover .title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
