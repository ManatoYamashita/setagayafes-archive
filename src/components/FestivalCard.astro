---
// One festival in the archive grid, after the reference layout: picture, then
// the round as a black pill with the dates beside it, the theme in bold, and
// grey "#" chips for the era and any status other than "held".
// The whole card is clickable through the heading link (stretched with
// ::after), so the link text stays the theme instead of the whole card.
//
// Pointing at the card (or moving focus into it) darkens the picture and
// shows "Visit the site" and "Preview" over it. Touch screens have no hover,
// so there the two buttons sit in a row at the bottom of the card instead.
import {
  ERA_NAMES,
  STATUS_LABELS,
  eraOf,
  linkOf,
  type Festival,
  type Lang,
} from "../data/festivals.ts";
import { UI, headingOf, roundLabel } from "../i18n/ui.ts";
import { formatDateRange } from "../lib/format.ts";
import Capture from "./Capture.astro";
import PreviewActions from "./PreviewActions.astro";

interface Props {
  festival: Festival;
  lang: Lang;
  /** The `sizes` attribute for the picture; the grid knows how wide the card is. */
  sizes: string;
}

const { festival, lang, sizes } = Astro.props;
const ui = UI[lang];
const { round, dates } = festival;
const era = eraOf(round);
const status = STATUS_LABELS[festival.status];
const external = festival.externalLink;
const heading = headingOf(festival, lang);
const label = roundLabel(round, lang);
const notes = [festival.statusReason?.[lang], external?.label[lang]].filter(Boolean);
---

<li class="card" data-era={era}>
  <article>
    <Capture round={round} widths={[320, 480, 640, 800, 960, 1080, 1280]} sizes={sizes} />
    <PreviewActions festival={festival} lang={lang} />
    <div class="body">
      <p class="meta">
        <span class="pill" aria-hidden="true">
          {label}
        </span>
        <time datetime={dates.start}>
          {formatDateRange(dates.start, dates.end)}
          {dates.estimated && <span>{ui.estimated}</span>}
        </time>
      </p>
      <h3 class="title">
        {/* The festival sites are in Japanese; say so on links from "/en/". */}
        <a href={linkOf(festival)} hreflang={lang === "ja" ? undefined : "ja"}>
          <span class="sr-only">{label} </span>
          <span lang={heading.lang === lang ? undefined : heading.lang}>{heading.text}</span>
          {heading.translation && <span class="translation">{heading.translation}</span>}
        </a>
      </h3>
      {notes.length > 0 && <p class="note">{notes.join(" / ")}</p>}
      <p class="tags">
        <span class="hashtag">#{ERA_NAMES[era][lang]}</span>
        {status && <span class="hashtag">#{status[lang]}</span>}
      </p>
    </div>
  </article>
</li>

<style>
  .card {
    position: relative;
    display: grid;
  }

  article {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 0.375rem;
    background-color: var(--color-paper);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 6px 20px rgb(0 0 0 / 0.05);
  }

  /*
   * The picture and the buttons share the first row; the text is the second.
   * :global: both are rendered by other components, outside this scope.
   */
  article > :global(.capture),
  article > :global(.preview-actions) {
    grid-area: 1 / 1;
  }

  .body {
    grid-row: 2;
  }

  /* Over the picture: a dark veil, hidden until the card is pointed at or focused. */
  article > :global(.preview-actions) {
    /* Above the stretched heading link, so the buttons get the clicks. */
    position: relative;
    z-index: 1;
    background-color: rgb(0 0 0 / 0.55);
    opacity: 0;
    transition: opacity 0.2s ease-out;
    /* The veil itself lets clicks through to the card's link. */
    pointer-events: none;
  }

  article > :global(.preview-actions > *) {
    pointer-events: none;
  }

  .card:focus-within article > :global(.preview-actions) {
    opacity: 1;
  }

  .card:focus-within article > :global(.preview-actions > *) {
    pointer-events: auto;
  }

  @media (hover: hover) {
    .card:hover article > :global(.preview-actions) {
      opacity: 1;
    }

    .card:hover article > :global(.preview-actions > *) {
      pointer-events: auto;
    }
  }

  /* Touch screens: no veil; the buttons sit in a row at the bottom of the card. */
  @media (hover: none) {
    article {
      grid-template-rows: auto 1fr auto;
    }

    article > :global(.preview-actions),
    .card:focus-within article > :global(.preview-actions) {
      grid-area: 3 / 1;
      padding: 0 1.125rem 1.25rem;
      background: none;
      opacity: 1;
      pointer-events: auto;
    }

    article > :global(.preview-actions > *) {
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    article > :global(.preview-actions) {
      transition: none;
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem 1.125rem 1.25rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.6;
    overflow-wrap: anywhere;

    & a {
      text-decoration: none;
    }

    /* Stretch the link over the whole card. */
    & a::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 0.375rem;
    }

    & a:focus-visible {
      outline: none;
    }
  }

  /* The English rendering of a Japanese theme, under the original on "/en/". */
  .translation {
    display: block;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .note {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* The chips sit at the bottom, so the chips of a row line up. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-block-start: auto;
    padding-block-start: 0.25rem;
  }

  .card:has(.title a:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
    border-radius: 0.375rem;
  }

  @media (hover: hover) {
    .card:hover .title a {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
  }
</style>
