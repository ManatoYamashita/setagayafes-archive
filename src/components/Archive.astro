---
// Every festival, newest first, in three even columns after the reference
// layout, with a filter by era (university name). The hero's festivals are
// listed here too, so a filter never hides the newest ones.
//
// The filter is three radio buttons and :has() — no JavaScript. The era names
// are fixed ("musashi", "tcu"), so the selectors below spell them out.
import { ERA_NAMES, FESTIVALS, eraOf, type Era, type Lang } from "../data/festivals.ts";
import { UI } from "../i18n/ui.ts";
import FestivalCard from "./FestivalCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];

const festivals = FESTIVALS.toSorted((a, b) => b.round - a.round);
const festivalsByEra = Map.groupBy(festivals, (festival) => eraOf(festival.round));

const ERAS: readonly Era[] = ["musashi", "tcu"];
const filters = [
  { id: "all", label: ui.filterAll, count: festivals.length },
  ...ERAS.map((era) => ({
    id: era,
    label: ERA_NAMES[era][lang],
    count: festivalsByEra.get(era)?.length ?? 0,
  })),
];

/*
 * Every card has the same width: a third of the grid (max 64rem, 1.5rem gaps)
 * from 64rem, half the page from 40rem, the full page below. Lazy pictures put
 * "auto" first in `sizes` (Capture.astro); this is the fallback.
 */
const SIZES =
  "(width >= 64rem) min(20.5rem, calc((100vw - 6rem) / 3)), (width >= 40rem) calc(50vw - 2.25rem), calc(100vw - 2rem)";
---

<section id="archive" class="archive" aria-labelledby="archive-title">
  <div class="page">
    <div class="head">
      <h2 id="archive-title" class="display-heading">
        {ui.archiveVertical && <span class="vertical">{ui.archiveVertical}</span>}
        <span class="word" lang={lang === "en" ? undefined : "en"}>
          {ui.archiveWord}
        </span>
      </h2>
      <p class="intro">{ui.archiveIntro}</p>
    </div>

    <div class="tools">
      <fieldset class="filter">
        <legend>{ui.filterLegend}</legend>
        <div class="options">
          {filters.map((filter) => (
            <label class="option">
              <input
                class="sr-only"
                type="radio"
                name="era"
                id={`era-${filter.id}`}
                value={filter.id}
                checked={filter.id === "all"}
              />
              {filter.label}
              <span class="count">{filter.count}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <p class="result">
        {filters.map((filter) => (
          <span class="result-text" data-filter={filter.id}>
            {ui.showing(filter.count)}
          </span>
        ))}
      </p>
    </div>

    <ul class="grid" role="list">
      {festivals.map((festival) => (
        <FestivalCard festival={festival} lang={lang} sizes={SIZES} />
      ))}
    </ul>
  </div>
</section>

<style>
  .archive {
    position: relative;
    /* Keeps the band (z-index -1) above the body's background. */
    isolation: isolate;
    padding-block: 2rem 5rem;

    /*
     * The wash band behind the grid: from the screen's left edge to about
     * four fifths of the page, starting at the heading's middle. On phones
     * it runs edge to edge, so it never cuts through the single column.
     */
    &::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset-block: 5.5rem 3rem;
      inset-inline: 0;

      @media (width >= 40rem) {
        inset-inline-end: 18%;
      }
      background-color: var(--color-wash);
    }
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: end;
    margin-inline: auto;
    max-inline-size: 64rem;

    @media (width >= 48rem) {
      grid-template-columns: auto minmax(0, 26rem);
      justify-content: space-between;
    }
  }

  .intro {
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin: 2.5rem auto 2rem;
    max-inline-size: 64rem;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;

    & legend {
      /* Floated, the legend sits in the row instead of on the border. */
      float: inline-start;
      margin-inline-end: 0.75rem;
      font-size: 0.75rem;
      line-height: 2.75rem;
    }
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    /* 44px tall touch target, drawn as a smaller pill. */
    min-block-size: 2.75rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    padding-inline: 0.875rem;
    background-color: var(--color-paper);
    font-size: 0.8125rem;
    font-weight: 700;
    cursor: pointer;

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-wash);
      }
    }

    &:has(:checked) {
      background-color: var(--color-ink);
      color: var(--color-paper);
    }

    &:has(:focus-visible) {
      outline: 2px solid var(--color-ink);
      outline-offset: 3px;
    }

    /* Forced colors drop the black fill; mark the picked era with the system's colors. */
    @media (forced-colors: active) {
      &:has(:checked) {
        forced-color-adjust: none;
        border-color: SelectedItem;
        background-color: SelectedItem;
        color: SelectedItemText;
      }
    }
  }

  .count {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.75;
  }

  .result {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Show only the line for the active filter. */
  .result-text {
    display: none;
  }

  .archive:has(#era-all:checked) [data-filter="all"],
  .archive:has(#era-musashi:checked) [data-filter="musashi"],
  .archive:has(#era-tcu:checked) [data-filter="tcu"] {
    display: inline;
  }

  .archive:has(#era-musashi:checked) .grid > :global([data-era]:not([data-era="musashi"])),
  .archive:has(#era-tcu:checked) .grid > :global([data-era]:not([data-era="tcu"])) {
    display: none;
  }

  .grid {
    display: grid;
    /* minmax(0, …): never let a long line widen the column past the screen. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-inline: auto;
    max-inline-size: 64rem;

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 2rem;
    }
  }
</style>
