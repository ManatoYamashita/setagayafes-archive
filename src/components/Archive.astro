---
// Every festival except the one in the hero, newest first, with a filter by
// era (university name).
//
// The filter is three radio buttons and :has() — no JavaScript. Hiding cards
// with display:none would break a pattern built on plain :nth-child, so the
// grid pattern counts only the cards that match the current filter, with
// :nth-child(An+B of S). The era names are fixed ("musashi", "tcu"), so the
// selectors below spell them out.
import {
  ERA_NAMES,
  FESTIVALS,
  eraOf,
  latestFestival,
  type Era,
  type Lang,
} from "../data/festivals.ts";
import { UI } from "../i18n/ui.ts";
import FestivalCard from "./FestivalCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = UI[lang];

const hero = latestFestival();
const festivals = FESTIVALS.filter((festival) => festival.round !== hero.round).toSorted(
  (a, b) => b.round - a.round,
);

const ERAS: readonly Era[] = ["musashi", "tcu"];
const filters = [
  { id: "all", label: ui.filterAll, count: festivals.length },
  ...ERAS.map((era) => ({
    id: era,
    label: ERA_NAMES[era][lang],
    count: festivals.filter((festival) => eraOf(festival.round) === era).length,
  })),
];

/*
 * How wide each card's picture is, for the `sizes` attribute. It follows the
 * grid pattern when no filter is applied (the state the page loads in):
 * - 3 columns (>= 64rem): cards 12n+1 and 12n+8 span 2 columns
 * - 2 columns (>= 40rem): the first card of every 5 spans 2 columns
 * - 1 column below that
 * A filter changes which cards are wide, so lazy pictures also put "auto"
 * first in `sizes` (see Capture.astro) and this is only the fallback.
 */
function sizesOf(index: number): string {
  const wide = index % 12 === 0 || index % 12 === 7 ? "min(48rem, 64vw)" : "min(23rem, 31vw)";
  const medium = index % 5 === 0 ? "calc(100vw - 3rem)" : "calc(50vw - 2.25rem)";
  return `(width >= 64rem) ${wide}, (width >= 40rem) ${medium}, calc(100vw - 2rem)`;
}
---

<section class="page archive" aria-labelledby="archive-title">
  <div class="head">
    <h2 id="archive-title" class="heading">
      <span class="dot" aria-hidden="true"></span>
      {ui.archive}
    </h2>
    <p class="intro">{ui.archiveIntro}</p>
  </div>

  <div class="tools">
    <fieldset class="filter">
      <legend>{ui.filterLegend}</legend>
      <div class="options">
        {filters.map((filter) => (
          <label class="option">
            <input
              class="sr-only"
              type="radio"
              name="era"
              id={`era-${filter.id}`}
              value={filter.id}
              checked={filter.id === "all"}
            />
            {filter.label}
            <span class="count">{filter.count}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <p class="result">
      {filters.map((filter) => (
        <span class="result-text" data-filter={filter.id}>
          {ui.showing(filter.count)}
        </span>
      ))}
    </p>
  </div>

  <ul class="grid" role="list">
    {festivals.map((festival, index) => (
      <FestivalCard festival={festival} lang={lang} sizes={sizesOf(index)} />
    ))}
  </ul>
</section>

<style>
  .archive {
    padding-block: 2.5rem 4rem;
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;

    @media (width >= 48rem) {
      grid-template-columns: 1fr minmax(0, 30rem);
      align-items: baseline;
    }
  }

  .heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .intro {
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-block: 1.5rem 2.5rem;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;

    & legend {
      /* Floated, the legend sits in the row instead of on the border. */
      float: inline-start;
      margin-inline-end: 0.75rem;
      font-size: 0.75rem;
      line-height: 2.75rem;
    }
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    /* 44px tall touch target, drawn as a smaller pill. */
    min-block-size: 2.75rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    padding-inline: 0.875rem;
    font-size: 0.8125rem;
    cursor: pointer;

    &:hover {
      background-color: var(--color-wash);
    }

    &:has(:checked) {
      background-color: var(--color-ink);
      color: var(--color-paper);
    }

    &:has(:focus-visible) {
      outline: 2px solid var(--color-ink);
      outline-offset: 3px;
    }
  }

  .count {
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .result {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Show only the line for the active filter. */
  .result-text {
    display: none;
  }

  .archive:has(#era-all:checked) [data-filter="all"],
  .archive:has(#era-musashi:checked) [data-filter="musashi"],
  .archive:has(#era-tcu:checked) [data-filter="tcu"] {
    display: inline;
  }

  .archive:has(#era-musashi:checked) .grid > :global([data-era]:not([data-era="musashi"])),
  .archive:has(#era-tcu:checked) .grid > :global([data-era]:not([data-era="tcu"])) {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 1.5rem;
    align-items: start;

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem 2rem;
    }
  }

  /*
   * 2 columns: one wide card, then two rows of two.
   */
  @media (40rem <= width < 64rem) {
    .archive:has(#era-all:checked) .grid > :global(:nth-child(5n + 1 of [data-era])),
    .archive:has(#era-musashi:checked) .grid > :global(:nth-child(5n + 1 of [data-era="musashi"])),
    .archive:has(#era-tcu:checked) .grid > :global(:nth-child(5n + 1 of [data-era="tcu"])) {
      grid-column: 1 / -1;
      --card-title-size: 1.75rem;
    }
  }

  /*
   * 3 columns, after the reference layout: a large card over two rows with
   * two small cards stacked beside it, then a row of three. The large card
   * alternates sides every six cards.
   *
   * The source order must stay the reading order (left to right, top to
   * bottom) so that Tab follows the picture. So there is no dense packing:
   * on the right-hand side the large card is the second of its group
   * (12n+8), after the small card on its left.
   */
  @media (width >= 64rem) {
    .archive:has(#era-all:checked) .grid > :global(:nth-child(12n + 1 of [data-era])),
    .archive:has(#era-musashi:checked) .grid > :global(:nth-child(12n + 1 of [data-era="musashi"])),
    .archive:has(#era-tcu:checked) .grid > :global(:nth-child(12n + 1 of [data-era="tcu"])) {
      grid-column: 1 / span 2;
      grid-row: span 2;
      --card-title-size: 2.25rem;
    }

    .archive:has(#era-all:checked) .grid > :global(:nth-child(12n + 8 of [data-era])),
    .archive:has(#era-musashi:checked) .grid > :global(:nth-child(12n + 8 of [data-era="musashi"])),
    .archive:has(#era-tcu:checked) .grid > :global(:nth-child(12n + 8 of [data-era="tcu"])) {
      grid-column: 2 / span 2;
      grid-row: span 2;
      --card-title-size: 2.25rem;
    }
  }
</style>
